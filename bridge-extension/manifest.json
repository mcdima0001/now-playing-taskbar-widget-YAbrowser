{
  "manifest_version": 3,
  "name": "Now Playing Bridge",
  "version": "1.4.2",
  "description": "Отдаёт текущий трек из вкладок браузера виджету Now Playing на панели задач.",
  "permissions": [
    "alarms",
    "scripting",
    "tabs"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "content.js"
      ]
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}